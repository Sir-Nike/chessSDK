{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:triad-tactics:chess:v1",
  "title": "Chess v1 participant wire contract",
  "$defs": {
    "initialize": {
      "type": "object",
      "properties": {
        "type": {
          "const": "initialize"
        },
        "protocol": {
          "const": "chess.v1"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "entry_id": {
          "type": "string",
          "minLength": 1
        },
        "colour": {
          "enum": [
            "white",
            "black"
          ]
        },
        "harness_config": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "properties": {
            "message_bytes": {
              "type": "integer",
              "minimum": 1024
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "invalid_limit": {
              "type": "integer",
              "minimum": 1
            },
            "context_tokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "message_bytes",
            "output_tokens",
            "invalid_limit"
          ],
          "additionalProperties": true
        },
        "inference": {
          "type": "object",
          "properties": {
            "transport": {
              "const": "http-unix"
            },
            "path": {
              "const": "/v1/inference"
            },
            "reasoning_efforts": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high"
                ]
              },
              "uniqueItems": true
            },
            "answer_token_reserve": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "transport",
            "path"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "protocol",
        "game_id",
        "attempt_id",
        "entry_id",
        "colour",
        "harness_config",
        "limits",
        "inference"
      ],
      "additionalProperties": true
    },
    "ready": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        },
        "protocol": {
          "const": "chess.v1"
        }
      },
      "required": [
        "type",
        "protocol"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "type": {
          "const": "position"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "position_version": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "const": "chess.v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "initial_fen": {
          "type": "string"
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fen": {
          "type": "string"
        },
        "side_to_move": {
          "enum": [
            "white",
            "black"
          ]
        },
        "white": {
          "type": "string",
          "minLength": 1
        },
        "black": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "preparing",
            "running",
            "suspended",
            "ended",
            "invalid"
          ]
        },
        "clock": {
          "type": "object",
          "properties": {
            "white": {
              "type": "number",
              "minimum": 0
            },
            "black": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "white",
            "black"
          ],
          "additionalProperties": false
        },
        "increment": {
          "type": "number",
          "minimum": 0
        },
        "result": {
          "enum": [
            null,
            "*",
            "1-0",
            "0-1",
            "1/2-1/2"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "barrier": {
          "type": "integer",
          "minimum": 0
        },
        "legal_moves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "game_id",
        "attempt_id",
        "position_version",
        "protocol",
        "decision_id",
        "initial_fen",
        "moves",
        "fen",
        "side_to_move",
        "white",
        "black",
        "status",
        "clock",
        "increment",
        "result",
        "reason",
        "barrier",
        "legal_moves"
      ],
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "const": "action"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "position_version": {
          "type": "integer",
          "minimum": 0
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "move",
            "resign"
          ]
        },
        "uci": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "game_id",
        "attempt_id",
        "position_version",
        "action_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": [
              "uci",
              "evidence"
            ]
          }
        }
      ]
    },
    "action_response": {
      "type": "object",
      "properties": {
        "type": {
          "const": "action_response"
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "position_version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalid_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "accepted",
        "reason",
        "position_version"
      ],
      "additionalProperties": true
    },
    "suspend": {
      "type": "object",
      "properties": {
        "type": {
          "const": "suspend"
        },
        "reason": {
          "type": "string"
        },
        "barrier": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "reason",
        "barrier"
      ],
      "additionalProperties": true
    },
    "resume": {
      "type": "object",
      "properties": {
        "type": {
          "const": "resume"
        },
        "barrier": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "barrier"
      ],
      "additionalProperties": true
    },
    "game_ended": {
      "type": "object",
      "properties": {
        "type": {
          "const": "game_ended"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "position_version": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "const": "chess.v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "initial_fen": {
          "type": "string"
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fen": {
          "type": "string"
        },
        "side_to_move": {
          "enum": [
            "white",
            "black"
          ]
        },
        "white": {
          "type": "string",
          "minLength": 1
        },
        "black": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "preparing",
            "running",
            "suspended",
            "ended",
            "invalid"
          ]
        },
        "clock": {
          "type": "object",
          "properties": {
            "white": {
              "type": "number",
              "minimum": 0
            },
            "black": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "white",
            "black"
          ],
          "additionalProperties": false
        },
        "increment": {
          "type": "number",
          "minimum": 0
        },
        "result": {
          "enum": [
            null,
            "*",
            "1-0",
            "0-1",
            "1/2-1/2"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "barrier": {
          "type": "integer",
          "minimum": 0
        },
        "legal_moves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "game_id",
        "attempt_id",
        "position_version",
        "protocol",
        "decision_id",
        "initial_fen",
        "moves",
        "fen",
        "side_to_move",
        "white",
        "black",
        "status",
        "clock",
        "increment",
        "result",
        "reason",
        "barrier",
        "legal_moves"
      ],
      "additionalProperties": true
    },
    "shutdown": {
      "type": "object",
      "properties": {
        "type": {
          "const": "shutdown"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "inference_request": {
      "type": "object",
      "properties": {
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "position_version": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant",
                  "tool"
                ]
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 65536
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_call_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_calls": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/tool_call"
                }
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "tool"
                    }
                  }
                },
                "then": {
                  "required": [
                    "content",
                    "tool_call_id"
                  ],
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "tool_call_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "tool_call_id": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "assistant"
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "required": [
                        "tool_calls"
                      ],
                      "properties": {
                        "tool_calls": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  ]
                },
                "else": {
                  "required": [
                    "content"
                  ],
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "tool_calls": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "stop": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "target_fen": {
          "type": [
            "string",
            "null"
          ]
        },
        "decoding": {
          "enum": [
            "text",
            "uci",
            "candidate_index"
          ],
          "default": "text"
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "reasoning_effort": {
          "enum": [
            null,
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "reasoning_budget_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "response_format": {
          "type": [
            "object",
            "null"
          ]
        },
        "tools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/tool_definition"
          }
        },
        "tool_choice": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "parallel_tool_calls": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "game_id",
        "attempt_id",
        "position_version",
        "messages"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decoding": {
                "const": "candidate_index"
              }
            },
            "required": [
              "decoding"
            ]
          },
          "then": {
            "required": [
              "candidates"
            ],
            "properties": {
              "candidates": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decoding": {
                "const": "text"
              }
            },
            "required": [
              "decoding"
            ]
          },
          "then": {
            "properties": {
              "candidates": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "inference_trace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "game": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "target_fen": {
          "type": "string"
        },
        "barrier": {
          "type": "integer",
          "minimum": 0
        },
        "to_move": {
          "type": "boolean"
        },
        "model_id": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "selected_move": {
          "type": [
            "string",
            "null"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "failure_kind": {
          "enum": [
            "invalid_input",
            "organizer_service"
          ]
        },
        "usage": {
          "type": "object"
        },
        "reasoning_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_reasoning_effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "effective_reasoning_budget_tokens": {
          "type": "integer",
          "minimum": -1
        },
        "output_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "generation_constraints": {
          "type": "object"
        },
        "message": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "status",
        "game",
        "attempt",
        "entry",
        "version",
        "target_fen",
        "barrier",
        "to_move",
        "model_id"
      ],
      "additionalProperties": true
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "tool_definition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "parameters": {
              "type": "object"
            },
            "strict": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "function"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/initialize"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/position"
    },
    {
      "$ref": "#/$defs/action"
    },
    {
      "$ref": "#/$defs/action_response"
    },
    {
      "$ref": "#/$defs/suspend"
    },
    {
      "$ref": "#/$defs/resume"
    },
    {
      "$ref": "#/$defs/game_ended"
    },
    {
      "$ref": "#/$defs/shutdown"
    }
  ]
}
